// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  username  String    @unique
  password  String    // Mật khẩu mã hóa
  name      String    // Tên người dùng
  role      String    // ADMIN, TEACHER, PARENT
  email     String?
  phone     String?
  students  Student[] // Một Phụ huynh có thể có nhiều học sinh (con) theo học
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Class {
  id        String      @id @default(uuid())
  name      String      @unique // Tên lớp, ví dụ: Mầm 1, Chồi 2, Lá 1
  room      String?     // Phòng học
  teacher   String      // Giáo viên chủ nhiệm
  students  Student[]
  menus     DailyMenu[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Student {
  id            String         @id @default(uuid())
  code          String?        @unique // Mã học sinh (VD: HS-2026-001)
  firstName     String
  lastName      String
  birthDate     DateTime
  gender        String         // Nam / Nữ
  ethnicity     String?        @default("Kinh")     // Dân tộc
  nationality   String?        @default("Việt Nam") // Quốc tịch
  residence     String?        // Nơi cư trú (Tạm trú / Thường trú)
  
  // Thông tin phụ huynh chi tiết theo từng bé
  fatherName    String?        // Họ tên cha
  fatherJob     String?        // Nghề nghiệp cha
  fatherPhone   String?        // Số điện thoại cha
  motherName    String?        // Họ tên mẹ
  motherJob     String?        // Nghề nghiệp mẹ
  motherPhone   String?        // Số điện thoại mẹ

  // Thông tin liên hệ đại diện & tài khoản
  parentId      String?
  parent        User?          @relation(fields: [parentId], references: [id])
  parentName    String
  parentPhone   String
  address       String?
  enrollmentDate DateTime?     @default(now()) // Ngày nhập học của bé
  classId       String
  class         Class          @relation(fields: [classId], references: [id])
  invoices      Invoice[]
  attendances   Attendance[]
  healthRecords HealthRecord[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Attendance {
  id           String   @id @default(uuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  date         DateTime // Ngày điểm danh
  status       String   // PRESENT (Có mặt), ABSENT_PERMIT (Vắng có phép), ABSENT_NO_PERMIT (Vắng không phép)
  pickupPerson String?  // Tên người đưa/đón trẻ
  notes        String?  // Ghi chú sức khỏe/tâm trạng buổi sáng
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HealthRecord {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  heightCm  Float?   // Chiều cao (cm)
  weightKg  Float?   // Cân nặng (kg)
  allergies String?  // Tiền sử dị ứng thực phẩm/thuốc
  bloodType String?  // Nhóm máu
  notes     String?  // Ghi chú thêm từ phụ huynh/bác sĩ
  updatedAt DateTime @updatedAt
}

model TuitionFee {
  id           String   @id @default(uuid())
  name         String   // Tên khoản thu (Học phí, Bữa ăn, Xe đưa đón, dã ngoại...)
  amount       Float    // Số tiền định mức
  type         String   // Loại thu: MONTHLY (Hằng tháng), ONE_TIME (Một lần), DAILY (Theo ngày thực tế)
  appliedClass String?  @default("ALL") // ALL (Toàn trường), MAM (Khối Mầm), CHOI (Khối Chồi), LA (Khối Lá) hoặc tên lớp
  isActive     Boolean  @default(true)  // Đang áp dụng / Tạm dừng
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Invoice {
  id            String    @id @default(uuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  month         Int       // Tháng thu học phí (1-12)
  year          Int       // Năm thu
  amount        Float     // Tổng số tiền cần đóng
  status        String    // UNPAID, PAID, OVERDUE (Chưa thanh toán, Đã thanh toán, Quá hạn)
  paymentDate   DateTime?
  paymentMethod String?   // CASH, TRANSFER, QR (Tiền mặt, Chuyển khoản, Quét QR)
  breakdownJson String?   // Chi tiết bóc tách các khoản thu dạng JSON
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model DailyMenu {
  id              String   @id @default(uuid())
  date            DateTime // Ngày áp dụng thực đơn
  classId         String?  // Lớp áp dụng (null nếu áp dụng cho toàn trường)
  class           Class?   @relation(fields: [classId], references: [id])
  breakfast       String   // Bữa sáng
  lunch           String   // Bữa trưa
  snack           String   // Bữa xế (bữa phụ)
  costPerStudent  Float    // Chi phí ước tính trên mỗi học sinh
  ingredientsJson String?  // Chi tiết nguyên liệu bóc tách theo bữa (Sáng, Trưa, Xế) dạng JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model IngredientCost {
  id        String   @id @default(uuid())
  date      DateTime // Ngày nhập/tiêu thụ nguyên liệu
  name      String   // Tên nguyên liệu (Thịt heo, Rau cải, Sữa, Gạo,...)
  quantity  Float    // Số lượng (kg, lít,...)
  unit      String   // Đơn vị tính (kg, bao, thùng)
  unitPrice Float    // Đơn giá
  totalCost Float    // Thành tiền (quantity * unitPrice)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== PHASE 7: QUẢN LÝ CHUYÊN SÂU =====

model Staff {
  id            String       @id @default(uuid())
  fullName      String
  dob           DateTime?    // Ngày sinh
  cccd          String?      // Thẻ CCCD / CMND
  phone         String
  email         String?
  position      String   // TEACHER, ASSISTANT, COOK, GUARD, ADMIN_STAFF
  specialty     String?  // Chuyên môn (Sư phạm Mầm non, Âm nhạc, Mỹ thuật...)
  degree        String?  // Bằng cấp chuyên môn
  startDate     DateTime // Ngày bắt đầu làm việc
  status        String   @default("ACTIVE") // ACTIVE, ON_LEAVE, RESIGNED
  assignedClass String?  // Lớp được phân công phụ trách
  workDays      Int?     @default(26) // Theo dõi: Ngày công trong tháng
  leaveDays     Int?     @default(0)  // Theo dõi: Nghỉ phép trong tháng
  salary        Float?   // Theo dõi: Mức lương (VNĐ)
  notes         String?
  evaluations   Evaluation[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(uuid())
  date        DateTime
  type        String   // INCOME (Thu), EXPENSE (Chi)
  category    String   // TUITION, MEAL_FEE, SALARY, KITCHEN, EQUIPMENT, UTILITY, OTHER
  amount      Float
  description String
  createdBy   String?  // Người tạo bút toán
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  type        String   // EVENT (Sự kiện), ANNOUNCEMENT (Thông báo), HOLIDAY (Nghỉ lễ)
  priority    String   @default("NORMAL") // URGENT, IMPORTANT, NORMAL
  targetClass String?  // null = toàn trường, hoặc tên lớp cụ thể
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== PHASE 8: QUẢN LÝ NÂNG CAO BAN GIÁM HIỆU =====

model Asset {
  id                  String               @id @default(uuid())
  code                String               @unique // Mã tài sản (VD: TS-001)
  name                String               // Tên tài sản (Máy chiếu, Máy điều hòa, Bàn ghế...)
  category            String               // ELECTRONIC (Điện tử), FURNITURE (Bàn ghế), TOY (Đồ chơi), KITCHEN (Bếp), OTHER
  location            String               // Phòng/Lớp phân bổ (Lớp Mầm 1, Bếp, Hội trường...)
  quantity            Int                  @default(1)
  status              String               @default("GOOD") // GOOD (Tốt), MAINTENANCE (Bảo trì), BROKEN (Hỏng)
  unitPrice           Float?
  purchaseDate        DateTime?
  notes               String?
  maintenanceRequests MaintenanceRequest[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model MaintenanceRequest {
  id          String   @id @default(uuid())
  assetId     String?
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assetName   String
  location    String
  issue       String   // Mô tả hỏng hóc/sự cố
  requestedBy String
  priority    String   @default("NORMAL") // URGENT, NORMAL
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  cost        Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id            String   @id @default(uuid())
  parentName    String
  childName     String
  childAgeGroup String   // Mầm (18-36T), Chồi (3-4T), Lá (4-5T)
  phone         String
  email         String?
  status        String   @default("NEW") // NEW (Mới), CONTACTED (Đã tư vấn), VISITED (Tham quan), ENROLLED (Đã nhập học), REJECTED (Từ chối)
  source        String?  // Facebook, Website, Giới thiệu, Trực tiếp
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Evaluation {
  id            String   @id @default(uuid())
  staffId       String?
  staff         Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffName     String
  month         String   // YYYY-MM
  score         Float    // Điểm đánh giá (0-100)
  rank          String   // EXCELLENT (Xuất sắc), GOOD (Tốt), FAIR (Khá), POOR (Cần cố gắng)
  attendancePts Float    @default(100)
  teachingPts   Float    @default(100)
  feedbackPts   Float    @default(100)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

